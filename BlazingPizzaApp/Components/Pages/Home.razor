@page "/"
@using BlazingPizzaApp.Data
@using BlazingPizzaApp.Model
@using BlazingPizzaApp.Components.Shared
@inject IPizzaSpecials PizzaSpecialsService
@inject OrderState OrderState
@inject NavigationManager NavManager

<!-- Container Utama dengan Flex untuk Responsive -->
<div class="content-wrapper">
    <!-- Bagian Kiri: Daftar Pizza -->
    <div class="main">
        <h1>Blazing Pizzas</h1>

        @if (isLoading)
        {
            <div class="loading-message">
                <p>Loading pizzas...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                <p>⚠️ Error: @errorMessage</p>
                <button @onclick="RetryLoadPizzas" class="btn btn-primary">Retry</button>
            </div>
        }
        else if (pizzaSpecials != null && pizzaSpecials.Count > 0)
        {
            <ul class="pizza-cards">
                @foreach (var pizzaSpecial in pizzaSpecials)
                {
                    <li @onclick="@(() => OrderState.ShowConfigurePizzaDialog(pizzaSpecial))" style="background-image: url('@pizzaSpecial.ImageUrl')">
                        <div class="pizza-info">
                            <span class="title">@pizzaSpecial.Name</span>
                            @pizzaSpecial.Description
                            <span class="price">@pizzaSpecial.GetFormattedBasePrice()</span>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-message">
                <p>No pizzas available</p>
            </div>
        }
    </div>

    <!-- Bagian Kanan: Sidebar Pesanan -->
    <div class="sidebar">
        @if (OrderState.Order.Pizzas.Any())
        {
            <div class="order-contents">
                <h2>Your order</h2>
                @foreach (var configuredPizza in OrderState.Order.Pizzas)
                {
                    <div class="cart-item">
                        <div class="title">@(configuredPizza.Size)" @configuredPizza.Special.Name</div>
                        <div class="item-price">
                            @configuredPizza.GetFormattedTotalPrice()
                        </div>
                        <a @onclick="@(() => OrderState.RemoveConfiguredPizza(configuredPizza))" class="delete-item">x</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-cart">Choose a pizza<br>to get started</div>
        }

        <div class="order-total @(OrderState.Order.Pizzas.Any() ? "" : "hidden")">
            Total:
            <span class="total-price">@OrderState.Order.GetFormattedTotalPrice()</span>
            <a href="checkout" class="@(OrderState.Order.Pizzas.Count == 0 ? "btn btn-warning disabled" : "btn btn-warning")">
                Order >
            </a>
        </div>
    </div>
</div>

<!-- Dialog Pop-Up -->
@if (OrderState.ShowingConfigureDialog)
{
    <ConfigurePizzaDialog Pizza="OrderState.ConfiguringPizza"
                          OnCancel="OrderState.CancelConfigurePizzaDialog"
                          OnConfirm="OrderState.ConfirmConfigurePizzaDialog" />
}

@code {
    private List<PizzaSpecial> pizzaSpecials = new();
    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPizzas();
    }

    private async Task LoadPizzas()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            pizzaSpecials = (await PizzaSpecialsService.GetPizzaSpecialsAsync()).ToList();

            if (pizzaSpecials.Count == 0)
            {
                errorMessage = "No pizzas found. Make sure the API server is running.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load pizzas: {ex.Message}. Make sure the API is running at https://localhost:7219/";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RetryLoadPizzas()
    {
        await LoadPizzas();
    }

    private void ViewPizzaDetail(string pizzaName)
    {
        NavManager.NavigateTo($"pizza/{pizzaName}?extratopping=ExtraCheese");
    }
}